{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@sentwrong/core": ["./packages/core/src/index.ts"] }
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["apps/**", "node_modules"]
}
