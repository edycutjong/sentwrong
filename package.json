{
  "name": "sentwrong",
  "version": "1.0.0",
  "private": true,
  "description": "Sent crypto to the wrong address? Paste it. Nansen labels decide which of four recovery routes you are on, and draft the ticket.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sentwrong": "tsx packages/cli/src/cli.ts",
    "spike": "tsx scripts/spike.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify.ts",
    "bench": "tsx scripts/bench.ts",
    "check:submission": "tsx scripts/check_submission_readiness.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "dev": "npm run dev -w apps/web",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck -w apps/web && npm run test:coverage && npm run verify && npm run check:submission",
    "ci:full": "npm run ci && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.1",
    "globals": "^17.12.0",
    "license-checker": "^25.0.1",
    "prettier": "^3.9.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
