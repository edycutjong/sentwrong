# ── Nansen ───────────────────────────────────────────────────
# Get from: https://app.nansen.ai/api  (free tier works — a verdict costs 0–13 credits; --deep costs 100)
# The CLI reads it from the environment; the web app keeps it server-side (apps/web/lib/engine.ts).
NANSEN_API_KEY=nsn_your-key-here

# ── Optional ─────────────────────────────────────────────────
# Absolute origin used for share links / OG images when not on Vercel (defaults to the request origin)
# SITE_URL=https://sentwrong-app.vercel.app
# CI / deterministic replay ONLY — replays fixtures/ with zero network. Never set this for the product.
# NANSEN_OFFLINE=1

# Spend guard on the public API route (defaults shown; see apps/web/lib/guard.ts)
GUARD_IP_PER_MIN=6
GUARD_DAILY_CREDITS=3000
