{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": { "@sentwrong/core": ["./packages/core/src/index.ts"], "@/*": ["./apps/web/*"] }
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"],
  "exclude": ["apps/**", "node_modules"]
}
